<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Unique remotes avoid shadowing the Lunaris core manifest's own remotes. -->
    <remote name="exyhyper" fetch="https://github.com/" />
    <remote name="lineageos" fetch="https://github.com/" />

    <!-- Galaxy Note 9 Exynos device trees -->
    <project
        name="ExyHyperBrick/android_device_samsung_crownlte"
        path="device/samsung/crownlte"
        remote="exyhyper"
        revision="lineage-23.2" />

    <project
        name="ExyHyperBrick/android_device_samsung_exynos9810-common"
        path="device/samsung/exynos9810-common"
        remote="exyhyper"
        revision="lineage-23.2" />

    <!-- Exynos 9810 kernel -->
    <project
        name="ExyHyperBrick/android_kernel_samsung_exynos9810"
        path="kernel/samsung/exynos9810"
        remote="exyhyper"
        revision="lineage-23.2" />

    <!-- Proprietary vendor files -->
    <project
        name="ExyHyperBrick/proprietary_vendor_samsung_crownlte"
        path="vendor/samsung/crownlte"
        remote="exyhyper"
        revision="lineage-23.2" />

    <project
        name="ExyHyperBrick/proprietary_vendor_samsung_exynos9810-common"
        path="vendor/samsung/exynos9810-common"
        remote="exyhyper"
        revision="lineage-23.2" />

    <!-- Samsung hardware integration -->
    <project
        name="LineageOS/android_hardware_samsung"
        path="hardware/samsung"
        remote="lineageos"
        revision="lineage-23.2" />

    <project
        name="LineageOS/android_device_samsung_slsi_sepolicy"
        path="device/samsung_slsi/sepolicy"
        remote="lineageos"
        revision="lineage-23.2" />

    <!-- The SLSI config.mk explicitly exports all five namespaces below. -->
    <project
        name="ExyHyperBrick/android_hardware_samsung_slsi-linaro_config"
        path="hardware/samsung_slsi-linaro/config"
        remote="exyhyper"
        revision="lineage-21" />

    <project
        name="ExyHyperBrick/android_hardware_samsung_slsi-linaro_exynos"
        path="hardware/samsung_slsi-linaro/exynos"
        remote="exyhyper"
        revision="lineage-23.2" />

    <project
        name="LineageOS/android_hardware_samsung_slsi-linaro_exynos5"
        path="hardware/samsung_slsi-linaro/exynos5"
        remote="lineageos"
        revision="lineage-23.2" />

    <project
        name="ExyHyperBrick/android_hardware_samsung_slsi-linaro_graphics"
        path="hardware/samsung_slsi-linaro/graphics"
        remote="exyhyper"
        revision="lineage-21" />

    <project
        name="LineageOS/android_hardware_samsung_slsi-linaro_interfaces"
        path="hardware/samsung_slsi-linaro/interfaces"
        remote="lineageos"
        revision="lineage-23.2" />

    <project
        name="LineageOS/android_hardware_samsung_slsi-linaro_openmax"
        path="hardware/samsung_slsi-linaro/openmax"
        remote="lineageos"
        revision="lineage-23.2" />
</manifest>
